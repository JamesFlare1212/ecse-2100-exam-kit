---
import { ClientRouter } from 'astro:transitions';
import '../styles/layout.css';
import favicon from '#lib/assets/favicon.svg';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="zh-CN" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="theme-color" content="#ad5030" />
    <title>{title} · Fieldnotes · ECSE 2100</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon.src} />
    <style is:global>html[data-locale-pending] body { visibility: hidden; }</style>
    <script is:inline data-astro-rerun>
      try {
        const p = JSON.parse(localStorage.getItem('ecse2100-fieldnotes-v1') || '{}');
        const dark = p.theme === 'dark' || ((!p.theme || p.theme === 'system') && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        if (p.version === 1 && p.locale === 'en') {
          document.documentElement.lang = 'en';
          document.documentElement.dataset.localePending = '';
          const revealFallback = () => {
            if (document.documentElement.hasAttribute('data-locale-pending')) {
              document.documentElement.lang = 'zh-CN';
              delete document.documentElement.dataset.localePending;
            }
          };
          window.addEventListener('error', (event) => {
            if (event instanceof ErrorEvent || event.target instanceof HTMLScriptElement) revealFallback();
          }, { capture: true, once: true });
          window.addEventListener('unhandledrejection', revealFallback, { once: true });
        }
        document.documentElement.dataset.navigation = p.sidebars?.navigation === false ? 'closed' : 'open';
        document.documentElement.dataset.references = p.sidebars?.references === false ? 'closed' : 'open';
      } catch {}
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <!-- Keep native Svelte portals attached when ClientRouter replaces the body. -->
    <div id="fieldnotes-overlays" transition:persist="study-overlays"></div>
    <slot />
  </body>
</html>
