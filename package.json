{
	"name": "ecse-2100-backexams",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"scripts": {
		"dev": "bun run papers:prepare && bun --bun astro dev",
		"build": "bun run papers:prepare && bun run content:check && bun --bun astro build && bun scripts/check_prerender.ts",
		"preview": "bun --bun astro preview --host 127.0.0.1 --port 4173",
		"prepare": "bun --bun astro sync",
		"check": "bun --bun astro check && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"test": "bun test",
		"content:check": "bun scripts/check_content.ts",
		"papers:prepare": "bun scripts/prepare_papers.ts",
		"assets:prepare": "python3 scripts/prepare_sources.py && python3 scripts/render_excerpts.py && python3 scripts/generate_figures.py"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/svelte": "^9.1.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/noto-sans-sc": "^5.3.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.4",
		"@types/katex": "^0.16.8",
		"@types/node": "^26",
		"@typescript/native": "npm:typescript@^7.0.2",
		"astro": "^7.4.2",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-math": "^3.0.0",
		"micromark-extension-math": "^3.1.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.7",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"katex": "^0.19.1"
	}
}
